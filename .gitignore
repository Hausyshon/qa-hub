# ============ 虚拟环境 ============
# 如果以后在项目内创建虚拟环境，忽略这些文件夹
venv/
env/
.venv/
# 你的虚拟环境在上一层，理论上不会被跟踪，但写上更保险
Scripts/
Lib/
pyvenv.cfg

# ============ Python 缓存 ============
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/

# ============ Django 相关 ============
# SQLite 数据库（本地开发用，不应上传）
db.sqlite3
db.sqlite3-journal

# 媒体文件（用户上传的头像等，不应上传）
media/

# 收集的静态文件（生产环境生成，不应上传）
staticfiles/

# ============ 环境变量 ============
.env
.env.local
*.env

# ============ IDE / 编辑器 ============
.idea/
.vscode/
*.swp
*.swo

# ============ 操作系统 ============
.DS_Store
Thumbs.db
desktop.ini

# ============ 日志 ============
*.log